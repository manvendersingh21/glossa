# Public, URL-restricted Mapbox token. Never put a secret token in NEXT_PUBLIC_*.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.replace_me --- IGNORE ---

# Server-only Google Routes API key for traffic-aware route estimates.
GOOGLE_MAPS_API_KEY=

# Overpass is called only by scheduled ingestion, never by map visitors.
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
INGEST_ALLOW_EMPTY_OSM=false

# Optional Socrata application token for higher API limits.
DATASF_APP_TOKEN=

# Protects manually-triggered production ingestion routes, if enabled.
INGEST_SECRET=
